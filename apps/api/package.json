{
  "name": "@corepos/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:local": "node dist/src/local/server.js",
    "dev:local": "tsx watch src/local/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/**/*.test.js",
    "test:postgres": "npm run build && node -e \"const url=process.env.TEST_DATABASE_URL;if(!url||!new URL(url).pathname.endsWith('_test'))throw new Error('test:postgres requires TEST_DATABASE_URL ending in _test.');\" && node --test dist/src/server.integration.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:normalize-roles": "tsx scripts/normalize-user-roles.ts",
    "db:seed": "tsx src/seed.ts",
    "import:sqlite": "tsx scripts/import-sqlite.ts",
    "db:backup:verified": "tsx scripts/backup-verified.ts",
    "db:prepare-production": "tsx scripts/prepare-production.ts",
    "uploads:audit": "tsx scripts/audit-upload-orphans.ts",
    "local:backup": "tsx scripts/local-backup.ts",
    "local:bootstrap": "tsx scripts/bootstrap-local.ts",
    "db:migrate:runtime": "node dist/scripts/migrate-runtime.js"
  },
  "dependencies": {
    "@corepos/shared-types": "2.0.0",
    "@corepos/validation": "2.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "pdfkit": "^0.20.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
