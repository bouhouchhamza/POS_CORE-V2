{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "CorePOS",
    "mainBinaryName": "CorePOS",
    "version": "2.0.11",
    "identifier":  "bond.nextora.cafe",
    "build":  {
                  "beforeDevCommand":  "npm run dev -w @corepos/web",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build:desktop -w @corepos/web",
                  "frontendDist":  "../../web/dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "CorePOS",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1024,
                                    "minHeight":  700,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src \u0027self\u0027 http://127.0.0.1:32145; img-src \u0027self\u0027 data: blob: http://127.0.0.1:32145; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; script-src \u0027self\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "msi",
                                   "nsis"
                               ],
                   "windows":  {
                                   "nsis":  {
                                                "installerHooks":  "./windows/hooks.nsh"
                                            },
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper",
                                                              "silent":  true
                                                          }
                               },
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "externalBin":  [
                                       "binaries/corepos-local-api"
                                   ]
               }
}

